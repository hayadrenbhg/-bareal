{
  "expo": {
    "name": "Be Reach",
    "slug": "be-reach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bereach",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bereach.app",
      "infoPlist": {
        "NSCameraUsageDescription": "トレーニング投稿のためにカメラを使用します",
        "NSPhotoLibraryUsageDescription": "プロフィール画像や投稿のために写真ライブラリを使用します"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.bereach.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0D0D0D"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "プロフィール画像を設定するために写真ライブラリへのアクセスが必要です"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "トレーニング投稿のためにカメラへのアクセスが必要です"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FF6B35"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e55b41b0-1d46-4839-93e5-63364f25f10b"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/e55b41b0-1d46-4839-93e5-63364f25f10b"
    }
  }
}
